# Example
EXAMPLE_SERVICE_URL=http://example_service:51888

# Environment -- must be exactly "development" or "production", nothing
# else (enforced by scripts/makefile/*_env.sh and the Dockerfile; a typo
# like "development" would otherwise silently be treated as neither).
# "development" (default): app/worker images are built with dev
# dependencies installed, and dev-only tooling (grafana, prometheus, loki,
# promtail, adminer, and -- when Celery is enabled -- flower,
# redis-commander) starts alongside the app, and Swagger UI (/docs,
# /redoc) is reachable. "production": only prod dependencies are
# installed, none of that dev-only tooling starts, and /docs/redoc are
# disabled (/openapi.json stays reachable, e.g. for importing the schema
# into Postman/Insomnia) -- a real deployment's metrics/log collection is
# a separate, deliberately secured decision (neither Prometheus nor Loki
# has built-in auth). Whether the dev-only services in docker-compose.yml
# actually start is derived automatically from this value (see
# scripts/makefile/*_env.sh) via COMPOSE_PROFILES -- that variable is
# generated, not something to set here directly.
ENVIRONMENT=development

# Service name -- used for the Docker Compose project name (and therefore
# every container name), the FastAPI app title, the app's own /metrics
# service-name label, the Celery app name, and Promtail's own-project log
# filter. Does NOT (yet) cover Prometheus's own scrape-config job_name or
# Grafana's provisioning display name -- those two are still hardcoded
# separately (see docs/plans/0-production-readiness-roadmap.md). A fork
# should set this to its own name in .secrets rather than editing this
# template value directly.
APP_SERVICE_NAME=fastapi-clean-example

# Uvicorn
UVICORN_PORT=8000

# App
APP_LOGGING_LEVEL=DEBUG

# "human" for readable local dev output, "json" for structured logs a shipper
# (e.g. Promtail, see docker-compose.yml) can parse and filter on.
APP_LOG_FORMAT=json

# Alerting - emails an on-call address for genuine unhandled (5xx-class) server
# errors only, never ordinary 4xx validation/business errors. Rate-limited per
# exception type (ALERT_COOLDOWN_S) so an outage can't flood the inbox.
# Uses the same EMAIL_* settings below to actually send.
# ALERT_TO_EMAILS/ALERT_CC_EMAILS/ALERT_BCC_EMAILS are comma-separated lists of
# addresses (e.g. ALERT_TO_EMAILS=oncall@yourdomain.com,backup@yourdomain.com).
ALERT_ENABLED=false
ALERT_TO_EMAILS=
ALERT_CC_EMAILS=
ALERT_BCC_EMAILS=
ALERT_COOLDOWN_S=300

# Jwt
JWT_SECRET=REPLACE_THIS_WITH_YOUR_OWN_SECRET_JWT_SECRET_VALUE

# Password
PASSWORD_PEPPER=REPLACE_THIS_WITH_YOUR_OWN_SECRET_PEPPER_VALUE

# Postgres
POSTGRES_DB=clean-example
# POSTGRES_HOST (like REDIS_HOST below) is the one setting here whose
# correct value depends on where `app` itself runs, not just on your
# deployment: `make upd` (Docker) needs Docker's internal service name
# (db_pg, as set here) since `app` runs on the same Docker network;
# `make upd-local` (scripts/makefile/local_env.sh) rewrites its own copy
# of this value to 127.0.0.1 instead, since `app` then runs on your host
# and can't resolve Docker-internal names at all. Do NOT also set
# POSTGRES_HOST in .secrets -- .secrets is appended after that rewrite
# (last-value-wins), so a duplicate entry there silently overrides it and
# breaks only the local path, in a way that's easy to miss (confirmed:
# alembic/uvicorn fail to resolve "db_pg" with a .secrets copy of this
# line still present, even though `make upd-local` looks like it worked).
POSTGRES_HOST=db_pg
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password

# Email (SMTP — works with any provider: Brevo, Mailgun, SES, etc.)
EMAIL_USE_CONSOLE=true
EMAIL_SMTP_HOST=smtp-relay.brevo.com
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USERNAME=
EMAIL_SMTP_PASSWORD=
EMAIL_SMTP_USE_TLS=true
EMAIL_FROM_EMAIL=noreply@yourdomain.com
EMAIL_FROM_NAME=Your Company Name

# Redis (Celery broker + result backend). DB and RESULT_DB are two different
# logical databases on the same Redis instance, keeping queue data and task
# results from colliding. Empty password matches a local Redis with no auth.
# REDIS_HOST has the same Docker-vs-local gotcha as POSTGRES_HOST above --
# see the comment there. Don't also set REDIS_HOST in .secrets.
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_RESULT_DB=1
REDIS_PASSWORD=

# Celery. Per-handler sync/background dispatch is chosen in code (see
# EventHandler.DISPATCH_MODE) -- these settings only configure how the
# "background" side is delivered.
# CELERY_ENABLED is the ONE setting that decides whether this deployment
# uses Celery at all -- set it to false for a deployment with no
# Redis/worker (e.g. to save cost); every handler then runs inline
# regardless of its own DISPATCH_MODE. Whether the `redis`/`worker`
# services in docker-compose.yml actually start is derived automatically
# from this value (see scripts/makefile/*_env.sh) via COMPOSE_PROFILES --
# that variable is generated, not something to set here directly. `flower`/
# `redis-commander` additionally require ENVIRONMENT=development (see below).
CELERY_ENABLED=true
CELERY_TASK_DEFAULT_QUEUE=events
CELERY_TASK_ACKS_LATE=true
CELERY_WORKER_PREFETCH_MULTIPLIER=1
# Celery's own default is one process per CPU core -- raise this only if
# your actual workload and host justify it.
CELERY_WORKER_CONCURRENCY=2
# Defaults to true (retain) even when unset -- see CelerySettings.OUTBOX_RETAIN_AFTER_RELAY.
# Set to false to have drain_outbox delete a row once it has been relayed.
CELERY_OUTBOX_RETAIN_AFTER_RELAY=true
# How often (in seconds) the worker process's own outbox drain loop ticks
# -- see CelerySettings.DRAIN_OUTBOX_INTERVAL_SECONDS. Raise this for a
# deployment where a background handler's effect showing up within a few
# seconds doesn't matter.
CELERY_DRAIN_OUTBOX_INTERVAL_SECONDS=3

# Flower (Celery task monitoring dashboard, see docker-compose.yml)
FLOWER_PORT=5555

# Redis Commander (browse the actual Redis broker/result-backend keys, see docker-compose.yml)
REDIS_COMMANDER_PORT=8081

# Observability stack (see docker-compose.yml/README.md "Observability" section)
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
LOKI_PORT=3100
ADMINER_PORT=8080

# Self-hosted docs wiki (see docs/plans/5-self-hosted-docs-wiki.md), dev-only like the rest of this section
WIKI_PORT=8001
