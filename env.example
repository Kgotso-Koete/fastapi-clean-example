# Example
EXAMPLE_SERVICE_URL=http://example_service:51888

# Uvicorn
UVICORN_PORT=8000

# App
APP_LOGGING_LEVEL=DEBUG

# Jwt
JWT_SECRET=REPLACE_THIS_WITH_YOUR_OWN_SECRET_JWT_SECRET_VALUE

# Password
PASSWORD_PEPPER=REPLACE_THIS_WITH_YOUR_OWN_SECRET_PEPPER_VALUE

# Postgres
POSTGRES_DB=clean-example
POSTGRES_HOST=db_pg
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password

# Email (SMTP — works with any provider: Brevo, Mailgun, SES, etc.)
EMAIL_USE_CONSOLE=true
EMAIL_SMTP_HOST=smtp-relay.brevo.com
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USERNAME=
EMAIL_SMTP_PASSWORD=
EMAIL_SMTP_USE_TLS=true
EMAIL_FROM_EMAIL=noreply@yourdomain.com
EMAIL_FROM_NAME=Your Company Name

# Toggle between synchronous (sync) vs background tasks (background)
EVENT_DISPATCH_MODE=background
