            "in": "query",
            "required": false,
            "schema": {
              "$ref": "#/components/schemas/ApiKeySortingField",
              "default": "created_at"
            }
          },
          {
            "name": "sorting_order",
            "in": "query",
            "required": false,
            "schema": {
              "$ref": "#/components/schemas/SortingOrder",
              "default": "desc"
            }
          }
        ],
        "responses": {
          "200": {
