    "/v1/account/profile/": {
      "get": {
        "tags": [
          "Account"
        ],
        "summary": "Get Own Profile",
        "description": "- Open to any authenticated caller, via whichever IdentityProvider the\n  container has -- cookie session (CoreProvider) or API key\n  (PublicApiProvider).\n- Self-service: returns the caller's OWN profile only.\n- No authorize() call -- viewing your own profile needs nothing beyond\n  being an authenticated, active user.\n- Bound unmodified into BOTH CoreProvider and PublicApiProvider -- the\n  concrete proof that CurrentUserService abstracts over the identity\n  mechanism: same class, same logic, two transports.",
        "operationId": "get_own_profile_v1_account_profile__get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserQm"
