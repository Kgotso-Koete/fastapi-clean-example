    "/v1/api-keys/{api_key_id}/usage/": {
      "get": {
        "tags": [
          "API Keys"
        ],
        "summary": "Get Api Key Usage Stats",
        "description": "- Open to any authenticated caller.\n- Returns usage-analytics stats (use_count/last_used_at) for ONE of\n  the caller's own API keys, by id.\n- By-id ownership-check convention, like RevokeApiKey -- not\n  ListApiKeys's \"scope the query itself\" one -- since this looks up a\n  single key by id rather than listing keys already scoped to the\n  caller from the start.",
        "operationId": "get_api_key_usage_stats_v1_api_keys__api_key_id__usage__get",
        "security": [
          {
            "APIKeyHeader": []
          }
        ],
        "parameters": [
