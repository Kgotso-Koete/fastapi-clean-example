  "paths": {
    "/v1/api-keys/": {
      "post": {
        "tags": [
          "API Keys"
        ],
        "summary": "Issue Api Key",
        "description": "- Open to everyone with valid credentials for an active account.\n- Mirrors LogIn's verify-credentials shape, but issues a long-lived API\n  key instead of a cookie session.\n- Deliberate difference from LogIn: does not check \"already\n  authenticated\" -- minting an additional key while another key/session\n  is already valid is the normal case (like GitHub/Stripe letting you\n  mint additional PATs from an already-logged-in dashboard), not a\n  corner case to block.",
        "operationId": "issue_api_key_v1_api_keys__post",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/IssueApiKeyRequest"
              },
              "examples": {
                "thirty_day_key": {
                  "summary": "Issue a key that expires in 30 days",
                  "value": {
                    "identifier": "peter-parker",
                    "password": "SpideySense2024!",
                    "expires_in_days": 30,
                    "label": "Spider-Sense Dev Key"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IssueApiKeyResponse"
                }
              }
            }
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StructuredErrorResponse"
                }
              }
            },
            "description": "Internal Server Error"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StructuredErrorResponse"
                }
              }
            },
            "description": "Service Unavailable"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StructuredErrorResponse"
                }
              }
            },
            "description": "Bad Request"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StructuredErrorResponse"
                }
              }
            },
            "description": "Unauthorized"
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StructuredErrorResponse"
                }
              }
            },
            "description": "Conflict"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      },
      "get": {
        "tags": [
          "API Keys"
        ],
        "summary": "List Api Keys",
        "description": "- Open to any authenticated caller.\n- Retrieves a paginated list of the caller's OWN API keys only.\n- Same authorization shape as ChangePassword/ChangeOwnPassword's\n  self-service pattern: no authorize() permission check -- scoped to\n  current_user.id_ by construction, not by a rule that could be\n  satisfied for someone else's keys.",
        "operationId": "list_api_keys_v1_api_keys__get",
        "security": [
          {
            "APIKeyHeader": []
          }
        ],
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 2147483647,
              "minimum": 1,
              "default": 20,
              "title": "Limit"
            }
          },
          {
            "name": "offset",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 2147483647,
              "minimum": 0,
              "default": 0,
              "title": "Offset"
            }
          },
          {
